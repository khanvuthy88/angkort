<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Job Categories for Job Portal -->
        
        <record id="category_technology" model="hr.job.category">
            <field name="name">Technology & IT</field>
            <field name="sequence">10</field>
            <field name="description">Software development, IT support, system administration, and technology-related positions</field>
        </record>

        <record id="category_design" model="hr.job.category">
            <field name="name">Design & Creative</field>
            <field name="sequence">20</field>
            <field name="description">Graphic design, UI/UX design, creative writing, and artistic positions</field>
        </record>

        <record id="category_marketing" model="hr.job.category">
            <field name="name">Marketing & Sales</field>
            <field name="sequence">30</field>
            <field name="description">Digital marketing, sales, advertising, and business development positions</field>
        </record>

        <record id="category_hr" model="hr.job.category">
            <field name="name">Human Resources</field>
            <field name="sequence">40</field>
            <field name="description">HR management, recruitment, training, and employee relations positions</field>
        </record>

        <record id="category_finance" model="hr.job.category">
            <field name="name">Finance & Accounting</field>
            <field name="sequence">50</field>
            <field name="description">Financial analysis, accounting, auditing, and financial management positions</field>
        </record>

        <record id="category_customer_service" model="hr.job.category">
            <field name="name">Customer Service</field>
            <field name="sequence">60</field>
            <field name="description">Customer support, call center, and client relations positions</field>
        </record>

        <record id="category_healthcare" model="hr.job.category">
            <field name="name">Healthcare</field>
            <field name="sequence">70</field>
            <field name="description">Medical, nursing, healthcare administration, and wellness positions</field>
        </record>

        <record id="category_education" model="hr.job.category">
            <field name="name">Education</field>
            <field name="sequence">80</field>
            <field name="description">Teaching, training, educational administration, and academic positions</field>
        </record>

        <record id="category_engineering" model="hr.job.category">
            <field name="name">Engineering</field>
            <field name="sequence">90</field>
            <field name="description">Mechanical, electrical, civil, and other engineering positions</field>
        </record>

        <record id="category_project_management" model="hr.job.category">
            <field name="name">Project Management</field>
            <field name="sequence">100</field>
            <field name="description">Project coordination, program management, and operational management positions</field>
        </record>

        <record id="category_legal" model="hr.job.category">
            <field name="name">Legal</field>
            <field name="sequence">110</field>
            <field name="description">Legal counsel, paralegal, compliance, and legal administration positions</field>
        </record>

        <record id="category_operations" model="hr.job.category">
            <field name="name">Operations</field>
            <field name="sequence">120</field>
            <field name="description">Operations management, logistics, supply chain, and administrative positions</field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Subscription Sequence -->
        <record id="seq_hr_subscription" model="ir.sequence">
            <field name="name">Job Portal Subscription</field>
            <field name="code">hr.subscription</field>
            <field name="prefix">SUB</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">False</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Subscription Cron Job for Expired Subscriptions -->
        <record id="ir_cron_check_expired_subscriptions" model="ir.cron">
            <field name="name">Check Expired Subscriptions</field>
            <field name="model_id" ref="model_hr_subscription"/>
            <field name="state">code</field>
            <field name="code">model.check_expired_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>

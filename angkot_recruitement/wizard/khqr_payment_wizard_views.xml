<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- KHQR Payment Wizard Form View -->
    <record id="view_khqr_payment_wizard_form" model="ir.ui.view">
        <field name="name">khqr.payment.wizard.form</field>
        <field name="model">khqr.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="KHQR Payment">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Generate KHQR Payment</span>
                        </h1>
                    </div>
                    <group>
                        <group string="Subscription Information">
                            <field name="subscription_id"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Payment Details">
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="invoice_id" invisible="invoice_id == False"/>
                        </group>
                    </group>
                    <group string="Bank Account">
                        <field name="partner_bank_id" options="{'no_create': True}"/>
                    </group>
                    <group string="QR Code" invisible="qr_code_data == False">
                        <field name="qr_code_data" readonly="1"/>
                        <div class="text-center" invisible="qr_code_image == False">
                            <div class="o_field_image oe_avatar">
                                <field name="qr_code_image" widget="image" options="{'size': [256, 256]}" readonly="1"/>
                            </div>
                            <p class="text-muted mt-3">
                                <strong>Scan this QR code with your banking app to complete the payment</strong>
                            </p>
                            <p class="text-muted">
                                Supported apps: ABA Mobile, ACLEDA Mobile, Wing, etc.
                            </p>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_qr_code" string="Generate QR Code" type="object" class="btn-primary" invisible="qr_code_data != False"/>
                    <button name="action_confirm_payment" string="Done" type="object" class="btn-primary" invisible="qr_code_data == False"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- KHQR Payment Wizard Action -->
    <record id="action_khqr_payment_wizard" model="ir.actions.act_window">
        <field name="name">KHQR Payment</field>
        <field name="res_model">khqr.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Recruitment Officer Group -->
        <record id="group_hr_recruitment_officer" model="res.groups">
            <field name="name">Recruitment Officer</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="comment">Officers can manage jobs and applicants assigned to them. They have limited access to only their assigned records.</field>
        </record>

        <!-- Job Applicant Group -->
        <record id="group_hr_recruitment_applicant" model="res.groups">
            <field name="name">Job Applicant</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="comment">Job applicants can view job postings and submit applications. They cannot create or manage job postings.</field>
        </record>

        <!-- Record Rules for Officer Group -->
        
        <!-- Job Record Rule: Officers can only see jobs assigned to them -->
        <record id="hr_job_officer_rule" model="ir.rule">
            <field name="name">Job: Officer Access</field>
            <field name="model_id" ref="hr.model_hr_job"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Applicant Record Rule: Officers can only see applicants for jobs assigned to them -->
        <record id="hr_applicant_officer_rule" model="ir.rule">
            <field name="name">Applicant: Officer Access</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="domain_force">['|', ('job_id.user_id', '=', user.id), ('job_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Job Category Record Rule: Officers can read all categories -->
        <record id="hr_job_category_officer_rule" model="ir.rule">
            <field name="name">Job Category: Officer Access</field>
            <field name="model_id" ref="model_hr_job_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rules for Applicant Group -->
        
        <!-- Job Record Rule: Applicants can only read active jobs -->
        <record id="hr_job_applicant_rule" model="ir.rule">
            <field name="name">Job: Applicant Access</field>
            <field name="model_id" ref="hr.model_hr_job"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Applicant Record Rule: Applicants can only see their own applications -->
        <record id="hr_applicant_applicant_rule" model="ir.rule">
            <field name="name">Applicant: Own Applications Only</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="domain_force">[('email_from', '=', user.login)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Job Category Record Rule: Applicants can read all categories -->
        <record id="hr_job_category_applicant_rule" model="ir.rule">
            <field name="name">Job Category: Applicant Access</field>
            <field name="model_id" ref="model_hr_job_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Candidate Record Rule: Applicants can only access their own candidate profile -->
        <record id="hr_candidate_applicant_rule" model="ir.rule">
            <field name="name">Candidate: Own Profile Only</field>
            <field name="model_id" ref="model_hr_candidate"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_applicant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Candidate Record Rule: Officers can access all candidates -->
        <record id="hr_candidate_officer_rule" model="ir.rule">
            <field name="name">Candidate: Officer Access</field>
            <field name="model_id" ref="model_hr_candidate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('angkot_recruitement.group_hr_recruitment_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Candidate Record Rule: Managers can access all candidates -->
        <record id="hr_candidate_manager_rule" model="ir.rule">
            <field name="name">Candidate: Manager Access</field>
            <field name="model_id" ref="model_hr_candidate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

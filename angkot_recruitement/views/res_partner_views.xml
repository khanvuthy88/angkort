<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add candidate contacts filter and search view -->
        <record id="view_partner_candidate_filter" model="ir.ui.view">
            <field name="name">res.partner.candidate.filter</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="before">
                    <separator/>
                    <filter string="Candidate Contacts" 
                            name="candidate_contacts"
                            domain="[('category_id', 'ilike', 'Candidate Contact')]"
                            help="Show contacts created from candidates"/>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="website" string="LinkedIn/Website" filter_domain="['|', ('website', 'ilike', self), ('website', 'ilike', self)]"/>
                </xpath>
            </field>
        </record>

        <!-- Add candidate contact form view -->
        <record id="view_partner_candidate_form" model="ir.ui.view">
            <field name="name">res.partner.candidate.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Add candidate info after name -->
                <xpath expr="//field[@name='name']" position="after">
                    <div class="alert alert-info" role="alert" invisible="not comment or 'Contact created from candidate:' not in comment">
                        <strong>Candidate Contact:</strong> This contact was created from a candidate record.
                        <button name="action_view_candidate_record" 
                                type="object" 
                                string="View Original Candidate" 
                                class="btn btn-sm btn-link float-end"
                                invisible="not comment or 'Original candidate ID:' not in comment"
                                help="View the original candidate record"/>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Add candidate contact tree view -->
        <record id="view_partner_candidate_tree" model="ir.ui.view">
            <field name="name">res.partner.candidate.tree</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <!-- Add candidate indicator -->
                <xpath expr="//field[@name='email']" position="after">
                    <field name="category_id" string="Categories" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='phone']" position="after">
                    <field name="website" string="LinkedIn" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Action for candidate contacts -->
        <record id="action_candidate_contacts" model="ir.actions.act_window">
            <field name="name">Candidate Contacts</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('category_id', 'ilike', 'Candidate Contact')]</field>
            <field name="context">{'search_default_candidate_contacts': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first candidate contact!
                </p>
                <p>
                    Candidate contacts are automatically created when you create an employee from a candidate,
                    or when you manually create a contact from a candidate record.
                </p>
            </field>
        </record>

        <!-- Menu item for candidate contacts -->
        <menuitem id="menu_candidate_contacts"
                  name="Candidate Contacts"
                  parent="hr_recruitment.menu_crm_case_categ0_act_job"
                  action="action_candidate_contacts"
                  sequence="25"/>

    </data>
</odoo>

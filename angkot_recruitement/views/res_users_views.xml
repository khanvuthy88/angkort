<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Inherit res.users form view to add candidate field -->
        <record id="res_users_view_form_inherit" model="ir.ui.view">
            <field name="name">res.users.form.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                
                <!-- Add candidate field in the Preferences tab -->
                <xpath expr="//notebook/page[@name='preferences']//group[@name='preferences']" position="inside">
                    <field name="candidate_id" 
                           string="Candidate Profile"
                           readonly="1"
                           invisible="not candidate_id"
                           help="Candidate profile linked to this user"/>
                </xpath>

                
                <!-- Add smart button to view candidate profile -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_candidate_profile" 
                            type="object"
                            string="View Candidate Profile"
                            icon="fa-user"
                            invisible="not has_candidate_profile"
                            help="Open the candidate profile associated with this user"/>
                </xpath>
                
            </field>
        </record>
        
        <!-- Inherit res.users tree view to show candidate info -->
        <record id="res_users_view_tree_inherit" model="ir.ui.view">
            <field name="name">res.users.tree.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                
                <!-- Add candidate column -->
                <xpath expr="//field[@name='login']" position="after">
                    <field name="candidate_id" 
                           string="Candidate Profile"
                           optional="hide"
                           invisible="not candidate_id"/>
                </xpath>
                
                <!-- Add candidate name for better identification -->
                <xpath expr="//field[@name='name']" position="after">
                    <field name="candidate_name" 
                           string="Candidate Name"
                           optional="hide"
                           invisible="not has_candidate_profile"/>
                </xpath>
                
            </field>
        </record>
        
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job Category Tree View -->
    <record id="view_hr_job_category_tree" model="ir.ui.view">
        <field name="name">hr.job.category.tree</field>
        <field name="model">hr.job.category</field>
        <field name="arch" type="xml">
            <tree string="Job Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active_job_count"/>
                <field name="job_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Job Category Form View -->
    <record id="view_hr_job_category_form" model="ir.ui.view">
        <field name="name">hr.job.category.form</field>
        <field name="model">hr.job.category</field>
        <field name="arch" type="xml">
            <form string="Job Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hr_job_category_jobs)d" type="action" 
                                class="oe_stat_button" icon="fa-briefcase">
                            <field name="active_job_count" widget="statinfo" string="Active Jobs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="job_count" readonly="1"/>
                            <field name="active_job_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe this job category..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Job Category Search View -->
    <record id="view_hr_job_category_search" model="ir.ui.view">
        <field name="name">hr.job.category.search</field>
        <field name="model">hr.job.category</field>
        <field name="arch" type="xml">
            <search string="Job Categories">
                <field name="name"/>
                <field name="description"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Job Category Kanban View -->
    <record id="view_hr_job_category_kanban" model="ir.ui.view">
        <field name="name">hr.job.category.kanban</field>
        <field name="model">hr.job.category</field>
        <field name="arch" type="xml">
            <kanban string="Job Categories">
                <field name="name"/>
                <field name="active_job_count"/>
                <field name="job_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="text-muted">
                                            <field name="active_job_count"/> active jobs
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Job Category Action -->
    <record id="action_hr_job_category" model="ir.actions.act_window">
        <field name="name">Job Categories</field>
        <field name="res_model">hr.job.category</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="view_hr_job_category_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first job category!
            </p>
            <p>
                Job categories help organize and classify job postings by functional area.
                This makes it easier for candidates to find relevant positions.
            </p>
        </field>
    </record>

    <!-- Action to show jobs in a category -->
    <record id="action_hr_job_category_jobs" model="ir.actions.act_window">
        <field name="name">Jobs in Category</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('job_category_id', '=', active_id)]</field>
        <field name="context">{'default_job_category_id': active_id}</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_hr_job_category_root" 
              name="Job Categories" 
              parent="hr_recruitment.menu_hr_recruitment_root" 
              sequence="20"/>

    <menuitem id="menu_hr_job_category" 
              name="Categories" 
              parent="menu_hr_job_category_root" 
              action="action_hr_job_category" 
              sequence="10"/>

</odoo>

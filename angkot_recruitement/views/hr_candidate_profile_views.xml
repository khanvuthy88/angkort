<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Actions for Profile Sections -->
    <record id="action_hr_candidate_education" model="ir.actions.act_window">
        <field name="name">Education</field>
        <field name="res_model">hr.candidate.education</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('candidate_id', '=', active_id)]</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>
    
    <record id="action_hr_candidate_experience" model="ir.actions.act_window">
        <field name="name">Work Experience</field>
        <field name="res_model">hr.candidate.experience</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('candidate_id', '=', active_id)]</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>
    
    <record id="action_hr_candidate_certification" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">hr.candidate.certification</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('candidate_id', '=', active_id)]</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>
    
    <record id="action_hr_candidate_portfolio" model="ir.actions.act_window">
        <field name="name">Portfolio Projects</field>
        <field name="res_model">hr.candidate.portfolio</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('candidate_id', '=', active_id)]</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>
    
    <!-- Menu items for standalone access (optional) -->
    <record id="action_hr_candidate_portfolio_tag" model="ir.actions.act_window">
        <field name="name">Technology Tags</field>
        <field name="res_model">hr.candidate.portfolio.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Education Form View -->
    <record id="view_hr_candidate_education_form" model="ir.ui.view">
        <field name="name">hr.candidate.education.form</field>
        <field name="model">hr.candidate.education</field>
        <field name="arch" type="xml">
            <form string="Education">
                <sheet>
                    <group>
                        <group>
                            <field name="school" placeholder="e.g. Stanford University"/>
                            <field name="degree"/>
                            <field name="field_of_study" placeholder="e.g. Computer Science"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date" invisible="is_current"/>
                            <field name="is_current"/>
                            <field name="gpa"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe your academic achievements, relevant coursework, GPA, honors, etc."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Education List View -->
    <record id="view_hr_candidate_education_tree" model="ir.ui.view">
        <field name="name">hr.candidate.education.tree</field>
        <field name="model">hr.candidate.education</field>
        <field name="arch" type="xml">
            <list string="Education">
                <field name="school"/>
                <field name="degree"/>
                <field name="field_of_study"/>
                <field name="duration_display"/>
                <field name="is_current"/>
            </list>
        </field>
    </record>

    <!-- Experience Form View -->
    <record id="view_hr_candidate_experience_form" model="ir.ui.view">
        <field name="name">hr.candidate.experience.form</field>
        <field name="model">hr.candidate.experience</field>
        <field name="arch" type="xml">
            <form string="Work Experience">
                <sheet>
                    <group>
                        <group>
                            <field name="company" placeholder="e.g. Google, Microsoft, Apple"/>
                            <field name="position" placeholder="e.g. Senior Software Engineer"/>
                            <field name="location" placeholder="e.g. San Francisco, CA"/>
                            <field name="employment_type"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date" invisible="is_current"/>
                            <field name="is_current"/>
                            <field name="duration_display"/>
                            <field name="duration_months"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe your role, responsibilities, and key accomplishments"/>
                    </group>
                    <group>
                        <field name="achievements" placeholder="List specific achievements, metrics, or results you achieved"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Experience List View -->
    <record id="view_hr_candidate_experience_tree" model="ir.ui.view">
        <field name="name">hr.candidate.experience.tree</field>
        <field name="model">hr.candidate.experience</field>
        <field name="arch" type="xml">
            <list string="Work Experience">
                <field name="position"/>
                <field name="company"/>
                <field name="employment_type"/>
                <field name="duration_display"/>
                <field name="duration_months"/>
                <field name="is_current"/>
            </list>
        </field>
    </record>

    <!-- Certification Form View -->
    <record id="view_hr_candidate_certification_form" model="ir.ui.view">
        <field name="name">hr.candidate.certification.form</field>
        <field name="model">hr.candidate.certification</field>
        <field name="arch" type="xml">
            <form string="Certification">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_credential_url" type="object" 
                                class="oe_stat_button" icon="fa-external-link"
                                invisible="not credential_url">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Verify</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. AWS Certified Solutions Architect"/>
                            <field name="issuer" placeholder="e.g. Amazon Web Services"/>
                            <field name="credential_id" placeholder="e.g. ABC123XYZ"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="status_display"/>
                            <field name="is_expired" invisible="1"/>
                            <field name="is_expiring_soon" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="credential_url" widget="url" placeholder="https://verify.example.com/credential"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Certification List View -->
    <record id="view_hr_candidate_certification_tree" model="ir.ui.view">
        <field name="name">hr.candidate.certification.tree</field>
        <field name="model">hr.candidate.certification</field>
        <field name="arch" type="xml">
            <list string="Certifications" decoration-danger="is_expired" decoration-warning="is_expiring_soon">
                <field name="name"/>
                <field name="issuer"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status_display"/>
                <field name="is_expired" invisible="1"/>
                <field name="is_expiring_soon" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Portfolio Form View -->
    <record id="view_hr_candidate_portfolio_form" model="ir.ui.view">
        <field name="name">hr.candidate.portfolio.form</field>
        <field name="model">hr.candidate.portfolio</field>
        <field name="arch" type="xml">
            <form string="Portfolio Project">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_project_url" type="object" 
                                class="oe_stat_button" icon="fa-external-link">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View Project</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="title" placeholder="e.g. E-commerce Platform"/>
                            <field name="project_type"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="url" widget="url" placeholder="https://github.com/username/project"/>
                            <field name="url_domain"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Brief description of the project, your role, and key features"/>
                    </group>
                    <group>
                        <field name="image_url" widget="url" placeholder="https://example.com/project-screenshot.png"/>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': False}"/>
                        <field name="tags_display"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Portfolio List View -->
    <record id="view_hr_candidate_portfolio_tree" model="ir.ui.view">
        <field name="name">hr.candidate.portfolio.tree</field>
        <field name="model">hr.candidate.portfolio</field>
        <field name="arch" type="xml">
            <list string="Portfolio" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="project_type"/>
                <field name="status"/>
                <field name="tags_display"/>
                <field name="url_domain"/>
            </list>
        </field>
    </record>

    <!-- Portfolio Kanban View -->
    <record id="view_hr_candidate_portfolio_kanban" model="ir.ui.view">
        <field name="name">hr.candidate.portfolio.kanban</field>
        <field name="model">hr.candidate.portfolio</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="title"/>
                <field name="description"/>
                <field name="image"/>
                <field name="url"/>
                <field name="project_type"/>
                <field name="tags_display"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hr.candidate.portfolio', 'image', record.id.raw_value)" alt="Project"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="title"/></strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="project_type"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="description"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="tags_display"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Portfolio Tag Form View -->
    <record id="view_hr_candidate_portfolio_tag_form" model="ir.ui.view">
        <field name="name">hr.candidate.portfolio.tag.form</field>
        <field name="model">hr.candidate.portfolio.tag</field>
        <field name="arch" type="xml">
            <form string="Technology Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Portfolio Tag List View -->
    <record id="view_hr_candidate_portfolio_tag_tree" model="ir.ui.view">
        <field name="name">hr.candidate.portfolio.tag.tree</field>
        <field name="model">hr.candidate.portfolio.tag</field>
        <field name="arch" type="xml">
            <list string="Technology Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

</odoo>


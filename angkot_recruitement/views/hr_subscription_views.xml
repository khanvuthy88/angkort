<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Tree View -->
    <record id="view_hr_subscription_tree" model="ir.ui.view">
        <field name="name">hr.subscription.tree</field>
        <field name="model">hr.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-info="status == 'trial'" decoration-success="status == 'active'" decoration-danger="status in ['cancelled', 'expired']">
                <field name="name"/>
                <field name="user_id"/>
                <field name="plan_id"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'trial'" decoration-warning="status == 'pending_payment'" decoration-danger="status in ['cancelled', 'expired']"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="price"/>
                <field name="currency_id" invisible="1"/>
                <field name="payment_method"/>
                <field name="auto_renew" widget="boolean_toggle"/>
                <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'pending'" decoration-danger="payment_status == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_hr_subscription_form" model="ir.ui.view">
        <field name="name">hr.subscription.form</field>
        <field name="model">hr.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="status not in ['pending_payment', 'trial']"/>
                    <button name="action_generate_invoice" string="Generate Invoice" type="object" class="btn-primary" invisible="invoice_id or payment_status == 'paid'"/>
                    <button name="%(angkot_recruitement.action_khqr_payment_wizard)d" string="Setup KHQR Payment" type="action" class="btn-primary" context="{'default_subscription_id': id}" invisible="payment_method != 'khqr' or payment_status == 'paid'"/>
                    <button name="action_generate_khqr" string="Quick Generate KHQR" type="object" class="btn-secondary" invisible="payment_method != 'khqr' or payment_status == 'paid' or partner_bank_id == False"/>
                    <button name="action_mark_as_paid" string="Mark as Paid" type="object" class="btn-success" invisible="payment_status == 'paid'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="status not in ['active', 'trial']"/>
                    <button name="action_expire" string="Expire" type="object" class="btn-secondary" invisible="status != 'active'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,trial,pending_payment"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="renew_subscription" type="object" class="oe_stat_button" icon="fa-refresh" invisible="status != 'active'">
                            <field name="auto_renew" widget="boolean_button" options="{'terminology': 'renewal'}"/>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="display_name" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="plan_id" widget="radio"/>
                            <field name="plan_name" readonly="1"/>
                        </group>
                        <group string="Subscription Details">
                            <field name="billing_cycle" widget="radio"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="auto_renew"/>
                            <field name="is_trial"/>
                            <field name="trial_end_date" invisible="is_trial == False"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pricing">
                            <field name="price"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="discount_percentage"/>
                            <field name="discounted_price" readonly="1"/>
                        </group>
                        <group string="Payment Information">
                            <field name="payment_method" widget="radio"/>
                            <field name="payment_status" widget="badge"/>
                            <field name="payment_date"/>
                            <field name="payment_reference"/>
                            <field name="invoice_id" readonly="1" invisible="invoice_id == False"/>
                            <field name="partner_bank_id" invisible="payment_method != 'khqr'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Plan Features">
                        <group>
                            <field name="max_jobs"/>
                            <field name="job_boost"/>
                            <field name="priority_support"/>
                        </group>
                        <group>
                            <field name="analytics"/>
                            <field name="custom_branding"/>
                        </group>
                    </group>
                    <group string="Additional Information">
                        <field name="days_remaining" readonly="1"/>
                        <field name="is_expired" readonly="1"/>
                        <field name="notes" placeholder="Additional notes about this subscription..."/>
                    </group>
                    <group string="KHQR Payment" invisible="payment_method != 'khqr'">
                        <field name="show_qr_code" invisible="1"/>
                        <field name="qr_code_data" readonly="1" invisible="qr_code_data == False"/>
                        <field name="qr_code_url" readonly="1" invisible="qr_code_url == False" widget="url"/>
                        <div invisible="show_qr_code == False" class="text-center">
                            <div class="o_field_image oe_avatar">
                                <field name="qr_code_image" widget="image" options="{'size': [256, 256]}" readonly="1"/>
                            </div>
                            <p class="text-muted">Scan this QR code to pay with KHQR</p>
                        </div>
                    </group>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <!-- Subscription Search View -->
    <record id="view_hr_subscription_search" model="ir.ui.view">
        <field name="name">hr.subscription.search</field>
        <field name="model">hr.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="payment_reference"/>
                <separator/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Trial" name="trial" domain="[('status', '=', 'trial')]"/>
                <filter string="Pending Payment" name="pending" domain="[('status', '=', 'pending_payment')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <separator/>
                <filter string="Auto Renewal" name="auto_renew" domain="[('auto_renew', '=', True)]"/>
                <filter string="Trial Subscriptions" name="is_trial" domain="[('is_trial', '=', True)]"/>
                <separator/>
                <filter string="KHQR Payment" name="khqr" domain="[('payment_method', '=', 'khqr')]"/>
                <filter string="Paid" name="paid" domain="[('payment_status', '=', 'paid')]"/>
                <filter string="Pending Payment" name="pending_payment" domain="[('payment_status', '=', 'pending')]"/>
                <separator/>
                <filter string="This Month" name="this_month" domain="[('start_date', '>=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), ('start_date', '&lt;', (context_today().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="this_year" domain="[('start_date', '>=', context_today().strftime('%Y-01-01')), ('start_date', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Billing Cycle" name="group_billing" context="{'group_by': 'billing_cycle'}"/>
                    <filter string="Payment Method" name="group_payment_method" context="{'group_by': 'payment_method'}"/>
                    <filter string="Payment Status" name="group_payment" context="{'group_by': 'payment_status'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Subscription Kanban View -->
    <record id="view_hr_subscription_kanban" model="ir.ui.view">
        <field name="name">hr.subscription.kanban</field>
        <field name="model">hr.subscription</field>
        <field name="arch" type="xml">
            <kanban string="Subscriptions" class="o_kanban_small_column">
                <field name="status"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="plan_id"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="end_date"/>
                <field name="days_remaining"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <small class="o_kanban_record_subtitle">
                                            <field name="user_id"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div>
                                            <strong>Plan:</strong> <field name="plan_id"/>
                                        </div>
                                        <div>
                                            <strong>Price:</strong> <field name="price"/> <field name="currency_id"/>
                                        </div>
                                        <div>
                                            <strong>End Date:</strong> <field name="end_date"/>
                                        </div>
                                        <div t-if="record.days_remaining.raw_value &gt; 0">
                                            <strong>Days Remaining:</strong> <field name="days_remaining"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Subscription Action -->
    <record id="action_hr_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">hr.subscription</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_hr_subscription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription!
            </p>
            <p>
                Manage job portal subscriptions for users. Track billing cycles, 
                plan features, and subscription status.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_hr_subscription_root" 
              name="Subscriptions" 
              parent="hr.menu_hr_root" 
              sequence="50"/>

    <menuitem id="menu_hr_subscription" 
              name="All Subscriptions" 
              parent="menu_hr_subscription_root" 
              action="action_hr_subscription" 
              sequence="10"/>

</odoo>

{
  "info": {
    "_postman_id": "angkort-shop-api-collection-refactored",
    "name": "Angkort Shop API (Refactored)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Refactored Postman collection for Angkort Shop API with form-data requests and Bearer Token authorization."
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/angkort/api/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "angkort",
                "api",
                "v1",
                "login"
              ]
            },
            "description": "Authenticate user credentials and generate an API access token. Store the returned token in the api_key environment variable."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/angkort/api/v1/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "angkort",
                "api",
                "v1",
                "logout"
              ]
            },
            "description": "Logout user and invalidate the current access token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_key}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="hr_attendance_form_extend" model="ir.ui.view">
            <field name="name">hr_attendance_form_extend</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
            <field name="arch" type="xml">
                <field name="check_in" position="after">
                    <field name="check_in_lat" />
                    <field name="check_in_long" />
                    <field name="check_in_note" />
                    <field name="check_in_photo" widget="image" />
                </field>
                <field name="check_out" position="after">
                    <field name="check_out_lat" />
                    <field name="check_out_long" />
                    <field name="check_out_note" />
                    <field name="check_out_photo" widget="image" />
                </field>
            </field>
        </record>
    </data>
</odoo>
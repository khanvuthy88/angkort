						"attendance"
					]
				},
				"description": "Retrieves all attendance records (default pagination: 50 records)"
			},
			"response": []
		},
		{
			"name": "List Attendances - By Status",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/attendance?status=late&limit=20",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",

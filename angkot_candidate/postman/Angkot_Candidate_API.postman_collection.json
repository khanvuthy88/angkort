{
  "info": {
    "_postman_id": "b8b41e9b-cfa6-4bd2-aed2-4f9972a4d0f3",
    "name": "Angkot Candidate API",
    "description": "Postman collection for candidate employee-form and document APIs under `/angkort/api/v1`.\n\nWorkflow:\n1. Run `Auth / Login` to populate `access_token`.\n2. Run `Candidate / List Documents` to populate `document_id` from the first document inside `document_groups`.\n3. Use the employee form and document upload requests.\n\nNotes:\n- Auth uses bearer token from `/angkort/api/v1/login`.\n- `List Documents` returns documents grouped by category in `data.document_groups`; there is no flat `data.documents` list.\n- `Upload Candidate Document` expects a real local file selected in Postman.\n- `Save Employee Form (Multipart Photo)` expects a local image file selected in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8012"
    },
    {
      "key": "api_prefix",
      "value": "/angkort/api/v1"
    },
    {
      "key": "username",
      "value": "candidate.portal@example.com"
    },
    {
      "key": "password",
      "value": "candidate_password"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "document_id",
      "value": ""
    },
    {
      "key": "candidate_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Login returns access token', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.data && body.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.data.access_token);",
                  "}",
                  "if (body.data && body.data.refresh_token) {",
                  "  pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "login"
              ]
            },
            "description": "Authenticate and store `access_token` / `refresh_token` into collection variables."
          }
        }
      ]
    },
    {
      "name": "Candidate",
      "item": [
        {
          "name": "Get Employee Form",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee form returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Employee form contains sections', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data).to.have.property('personalInformation');",
                  "  pm.expect(body.data).to.have.property('familyInformation');",
                  "  pm.expect(body.data).to.have.property('spouseInformation');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/employee-form",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "employee-form"
              ]
            }
          }
        },
        {
          "name": "Save Employee Form (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee form save returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Employee form save succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.personalInformation.englishName).to.eql('John Doe');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personalInformation\": {\n    \"englishName\": \"John Doe\",\n    \"khmerName\": \"ជន ដូ\",\n    \"position\": \"Operator\",\n    \"gender\": \"male\",\n    \"maritalStatus\": \"single\",\n    \"contactNumber\": \"012345678\",\n    \"nationalIdOrPassport\": \"A1234567\",\n    \"placeOfBirth\": \"Kampong Cham\",\n    \"permanentAddress\": \"Permanent Address\",\n    \"currentAddress\": \"Current Address\",\n    \"dateOfBirth\": \"1999-12-31\"\n  },\n  \"familyInformation\": {\n    \"fatherName\": \"Father Test\",\n    \"fatherJob\": \"Farmer\",\n    \"motherName\": \"Mother Test\",\n    \"motherJob\": \"Vendor\",\n    \"numberOfSiblings\": \"4\",\n    \"contactNumber\": \"099999999\",\n    \"permanentAddress\": \"Family Permanent\",\n    \"currentAddress\": \"Family Current\"\n  },\n  \"spouseInformation\": {\n    \"name\": \"Spouse Test\",\n    \"job\": \"Teacher\",\n    \"numberOfChildren\": \"2\",\n    \"contactNumber\": \"088888888\",\n    \"permanentAddress\": \"Spouse Permanent\",\n    \"currentAddress\": \"Spouse Current\"\n  },\n  \"educationInformation\": {\n    \"degreeTypes\": \"Bachelor\",\n    \"major\": \"Accounting\",\n    \"other\": \"Honors\",\n    \"yearsOfStudy\": \"2018-2022\"\n  },\n  \"shortCourseInformation\": {\n    \"shortCourseCertificates\": \"Computer Skills\",\n    \"shortCourseDuration\": \"6 months\",\n    \"major\": \"Excel\",\n    \"other\": \"Advanced\"\n  },\n  \"employmentHistory\": {\n    \"name\": \"Latest Co\",\n    \"position\": \"Clerk\",\n    \"durationOfWork\": \"2 years\",\n    \"jobResponsibility\": \"Handle records\",\n    \"other\": \"Night shift\"\n  },\n  \"otherInformation\": {\n    \"hadInjury\": true,\n    \"hadInjuryDescription\": \"Recovered leg injury\",\n    \"arrested\": false,\n    \"arrestedDescription\": \"\"\n  },\n  \"declaration\": {\n    \"date\": \"2026-04-05\",\n    \"signature\": \"<svg>signature</svg>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/employee-form",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "employee-form"
              ]
            }
          }
        },
        {
          "name": "Save Employee Form (Multipart Photo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Multipart employee form returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "englishName",
                  "value": "Photo Candidate",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/employee-form",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "employee-form"
              ]
            },
            "description": "Select a local image file in Postman for the `photo` field before sending."
          }
        },
        {
          "name": "Get Employee Photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee photo returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/employee-form/photo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "employee-form",
                "photo"
              ]
            }
          }
        },
        {
          "name": "List Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Documents list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Documents list succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.document_groups).to.be.an('array');",
                  "  pm.expect(body.data.document_groups[0].documents).to.be.an('array');",
                  "});",
                  "var firstDocument = null;",
                  "if (body.data && body.data.document_groups) {",
                  "  body.data.document_groups.some(function (group) {",
                  "    if (group.documents && group.documents.length) {",
                  "      firstDocument = group.documents[0];",
                  "      return true;",
                  "    }",
                  "    return false;",
                  "  });",
                  "}",
                  "if (firstDocument) {",
                  "  pm.collectionVariables.set('document_id', String(firstDocument.id));",
                  "}",
                  "if (body.data && body.data.candidate_id) {",
                  "  pm.collectionVariables.set('candidate_id', String(body.data.candidate_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents"
              ],
              "query": [
                {
                  "key": "candidate_id",
                  "value": "{{candidate_id}}",
                  "disabled": true,
                  "description": "Optional. Use this when logged in as Encharge Officer or HR Document Reviewer to load a specific candidate's checklist."
                }
              ]
            },
            "description": "Fetch the current candidate document checklist grouped by category.\n\nAuthentication: Bearer token required.\n\nAccess:\n- Candidate role: can list their own candidate checklist.\n- Encharge Officer role: can list candidates assigned to them by `officer_user_id`; pass `candidate_id` when needed.\n- HR Document Reviewer role: can list any candidate checklist; pass `candidate_id` when needed.\n\nQuery parameters:\n- `candidate_id` optional integer. Recommended for Encharge Officer and HR Document Reviewer users when opening a specific candidate.\n\nResponse body:\n- `data.candidate_id`: Current candidate ID.\n- `data.candidate_name`: Current candidate display name.\n- `data.required_document_count`: Total required checklist items.\n- `data.submitted_document_count`: Number of submitted documents awaiting review.\n- `data.accepted_document_count`: Number of HR-accepted documents.\n- `data.document_groups`: Array of category groups. The API does not return a flat `data.documents` list.\n\nEach `document_groups[]` item contains:\n- `category`: Machine key such as `identity`, `education`, `banking`, or `compliance`.\n- `label`: Human-readable category label.\n- `completed`: Required documents in this category with status `submitted` or `accepted`.\n- `total`: Required documents in this category.\n- `documents`: Checklist documents in this category.\n\nEach `documents[]` item contains:\n- `id`: Document checklist line ID. Use this value for upload/content routes.\n- `name`, `code`, `category`, `required`, `status`.\n- `filename`, `mimetype`, `upload_date`.\n- `review_note`, `reviewed_by`, `reviewed_on`.\n- `has_attachment` and `view_url`.\n\nExample upload route after this request stores `document_id`:\n`POST {{base_url}}{{api_prefix}}/candidate/documents/{{document_id}}/upload`"
          }
        },
        {
          "name": "Upload Candidate Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Document upload returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Document upload succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.has_attachment).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/documents/{{document_id}}/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents",
                "{{document_id}}",
                "upload"
              ]
            },
            "description": "Select a local PDF or image file in Postman for the `file` field before sending."
          }
        },
        {
          "name": "View Candidate Document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/documents/{{document_id}}/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents",
                "{{document_id}}",
                "content"
              ]
            }
          }
        },
        {
          "name": "Download Candidate Document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/documents/{{document_id}}/content?download=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents",
                "{{document_id}}",
                "content"
              ],
              "query": [
                {
                  "key": "download",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}

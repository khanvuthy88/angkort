                  "pm.test('document groups response envelope', function () {",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data.document_groups).to.be.an('array');",
                  "});",
                  "let firstDocument = null;",
                  "for (const group of body.data.document_groups || []) {",
                  "  if (group.documents && group.documents.length) { firstDocument = group.documents[0]; break; }",
                  "}",
                  "if (firstDocument) {",
                  "  pm.collectionVariables.set('document_id', firstDocument.id);",
                  "  pm.environment.set('document_id', firstDocument.id);",
                  "}"
                ]
              }
            }
          ]
        },

{
  "info": {
    "_postman_id": "b8b41e9b-cfa6-4bd2-aed2-4f9972a4d0f3",
    "name": "Angkot Candidate API",
    "description": "Postman collection for candidate employee-form and document APIs under `/angkort/api/v1`.\n\nWorkflow:\n1. Run `Auth / Login` to populate `access_token`, `refresh_token`, and `user_role`.\n2. Run `Candidate / List Documents` to populate `document_id` from the first document inside `document_groups`.\n3. Use the employee form and document upload requests.\n\nNotes:\n- Auth uses bearer token from `/angkort/api/v1/login`.\n- Login returns `data.role` as one of `candidate`, `encharge_officer`, `hr_document_reviewer`, or `user`.\n- `List Documents` returns documents grouped by category in `data.document_groups`; there is no flat `data.documents` list.\n- `Upload Candidate Document` expects a real local file selected in Postman.\n- `Save Employee Form (Multipart Photo)` expects a local image file selected in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8012"
    },
    {
      "key": "api_prefix",
      "value": "/angkort/api/v1"
    },
    {
      "key": "username",
      "value": "candidate.portal@example.com"
    },
    {
      "key": "password",
      "value": "candidate_password"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_role",
      "value": ""
    },
    {
      "key": "document_id",
      "value": ""
    },
    {
      "key": "candidate_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Login returns access token', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.data.role).to.be.oneOf(['candidate', 'encharge_officer', 'hr_document_reviewer', 'user']);",
                  "});",
                  "if (body.data && body.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.data.access_token);",
                  "}",
                  "if (body.data && body.data.refresh_token) {",
                  "  pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "}",
                  "if (body.data && body.data.role) {",
                  "  pm.collectionVariables.set('user_role', body.data.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "login"
              ]
            },
            "description": "Authenticate and store `access_token`, `refresh_token`, and `user_role` into collection variables.\n\nResponse `data.role` enum values:\n- `candidate`\n- `encharge_officer`\n- `hr_document_reviewer`\n- `user`"
          }
        }
      ]
    },

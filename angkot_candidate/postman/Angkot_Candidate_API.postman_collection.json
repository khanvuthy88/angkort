                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents",
                "{{document_id}}",
                "reject"
              ]
            },
            "description": "Convenience route for rejecting a submitted document. Same access rules as the review route."
          }
        },
        {
          "name": "View Candidate Document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/documents/{{document_id}}/content",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents",
                "{{document_id}}",
                "content"
              ]
            }
          }
        },
        {
          "name": "Download Candidate Document",

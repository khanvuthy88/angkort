              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents",
                "{{document_id}}",
                "review"
              ]
            },
            "description": "Review a submitted document.\n\nAccess:\n- Encharge Officer: can review documents for assigned candidates.\n- HR Document Reviewer: can review any candidate document.\n- Candidate users cannot review documents.\n\nBody:\n- `status`: required. Use `accepted` or `rejected`.\n- `review_note`: optional reviewer note.\n\nThe document must already have an uploaded attachment."
          }

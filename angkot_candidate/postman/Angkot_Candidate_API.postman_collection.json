        {
          "name": "List Candidates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidates list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Candidates list succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.candidates).to.be.an('array');",
                  "});",
                  "if (body.data && body.data.candidates && body.data.candidates.length) {",
                  "  pm.collectionVariables.set('candidate_id', String(body.data.candidates[0].id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidates",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidates"
              ]
            },
            "description": "List candidates visible to the logged-in user with basic candidate information only.\n\nAuthentication: Bearer token required.\n\nAccess:\n- Candidate role: returns only the candidate linked to the logged-in portal user.\n- Encharge Officer role: returns candidates assigned to the logged-in officer by `officer_user_id`.\n- HR Document Reviewer role: returns all candidates.\n\nResponse body:\n- `data.candidates`: Array of basic candidate records.\n- `meta.count`: Number of returned candidates.\n\nEach `data.candidates[]` item contains:\n- `id`, `name`, `khmerName`, `englishName`, `position`.\n- `gender`, `maritalStatus`, `dateOfBirth`.\n- `contactNumber`, `email`, `nationalIdOrPassport`.\n- `officer`: Assigned Encharge Officer summary.\n- `portalUser`: Linked candidate user summary.\n- `documentSummary`: Required/submitted/accepted document counts.\n\nThis route does not include full employee-form sections or document groups."
          }
        },
        {
          "name": "Get Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Candidate detail returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Candidate detail succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.id).to.be.a('number');",
                  "  pm.expect(body.data).to.have.property('documentSummary');",
                  "});",
                  "if (body.data && body.data.id) {",
                  "  pm.collectionVariables.set('candidate_id', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidates/{{candidate_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidates",
                "{{candidate_id}}"
              ]
            },
            "description": "Fetch one candidate's basic information.\n\nAuthentication: Bearer token required.\n\nAccess:\n- Candidate role: can fetch only their linked candidate.\n- Encharge Officer role: can fetch assigned candidates only.\n- HR Document Reviewer role: can fetch any candidate.\n\nResponse body uses the same basic candidate shape as `GET /candidates`."
          }
        },
        {
          "name": "List Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Documents list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Documents list succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.document_groups).to.be.an('array');",
                  "  pm.expect(body.data.document_groups[0].documents).to.be.an('array');",
                  "});",
                  "var firstDocument = null;",
                  "if (body.data && body.data.document_groups) {",
                  "  body.data.document_groups.some(function (group) {",
                  "    if (group.documents && group.documents.length) {",
                  "      firstDocument = group.documents[0];",
                  "      return true;",
                  "    }",
                  "    return false;",
                  "  });",
                  "}",
                  "if (firstDocument) {",
                  "  pm.collectionVariables.set('document_id', String(firstDocument.id));",
                  "}",
                  "if (body.data && body.data.candidate_id) {",
                  "  pm.collectionVariables.set('candidate_id', String(body.data.candidate_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidate/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidate",
                "documents"
              ],
              "query": [
                {
                  "key": "candidate_id",
                  "value": "{{candidate_id}}",
                  "disabled": true,
                  "description": "Optional. Use this when logged in as Encharge Officer or HR Document Reviewer to load a specific candidate's checklist."
                }
              ]
            },
            "description": "Fetch the current candidate document checklist grouped by category.\n\nAuthentication: Bearer token required.\n\nAccess:\n- Candidate role: can list their own candidate checklist.\n- Encharge Officer role: can list candidates assigned to them by `officer_user_id`; pass `candidate_id` when needed.\n- HR Document Reviewer role: can list any candidate checklist; pass `candidate_id` when needed.\n\nQuery parameters:\n- `candidate_id` optional integer. Recommended for Encharge Officer and HR Document Reviewer users when opening a specific candidate.\n\nResponse body:\n- `data.candidate_id`: Current candidate ID.\n- `data.candidate_name`: Current candidate display name.\n- `data.required_document_count`: Total required checklist items.\n- `data.submitted_document_count`: Number of submitted documents awaiting review.\n- `data.accepted_document_count`: Number of HR-accepted documents.\n- `data.document_groups`: Array of category groups. The API does not return a flat `data.documents` list.\n\nEach `document_groups[]` item contains:\n- `category`: Machine key such as `identity`, `education`, `banking`, or `compliance`.\n- `label`: Human-readable category label.\n- `completed`: Required documents in this category with status `submitted` or `accepted`.\n- `total`: Required documents in this category.\n- `documents`: Checklist documents in this category.\n\nEach `documents[]` item contains:\n- `id`: Document checklist line ID. Use this value for upload/content routes.\n- `name`, `code`, `category`, `required`, `status`.\n- `filename`, `mimetype`, `upload_date`.\n- `review_note`, `reviewed_by`, `reviewed_on`.\n- `has_attachment` and `view_url`.\n\nExample upload route after this request stores `document_id`:\n`POST {{base_url}}{{api_prefix}}/candidate/documents/{{document_id}}/upload`"
          }
        },
        {
          "name": "List All Candidate Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('All candidate documents returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('All candidate documents succeeds', function () {",
                  "  pm.expect(body.status).to.eql(true);",
                  "  pm.expect(body.data.candidates).to.be.an('array');",
                  "});",
                  "var firstDocument = null;",
                  "if (body.data && body.data.candidates && body.data.candidates.length) {",
                  "  pm.collectionVariables.set('candidate_id', String(body.data.candidates[0].candidate_id));",
                  "  body.data.candidates.some(function (candidate) {",
                  "    return (candidate.document_groups || []).some(function (group) {",
                  "      if (group.documents && group.documents.length) {",
                  "        firstDocument = group.documents[0];",
                  "        return true;",
                  "      }",
                  "      return false;",
                  "    });",
                  "  });",
                  "}",
                  "if (firstDocument) {",
                  "  pm.collectionVariables.set('document_id', String(firstDocument.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/candidates/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "candidates",
                "documents"
              ]
            },
            "description": "List candidates visible to the logged-in user, each with grouped document checklist data.\n\nAuthentication: Bearer token required.\n\nAccess:\n- Candidate role: returns only the candidate linked to the logged-in portal user.\n- Encharge Officer role: returns candidates assigned to the logged-in officer by `officer_user_id`.\n- HR Document Reviewer role: returns all candidates.\n\nResponse body:\n- `data.candidates`: Array of candidate document summaries.\n- `meta.count`: Number of returned candidates.\n\nEach `data.candidates[]` item contains:\n- `candidate_id`, `candidate_name`.\n- `required_document_count`, `submitted_document_count`, `accepted_document_count`.\n- `document_groups`: Grouped checklist documents using the same shape as `GET /candidate/documents`."
          }
        },
        {
          "name": "Upload Candidate Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Document upload returns 201', function () {",

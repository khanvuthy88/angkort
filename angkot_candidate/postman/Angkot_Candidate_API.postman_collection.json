                "candidates"
              ]
            },
            "description": "Lists visible candidates. Candidates see their own record; recruiters/officers see assigned records; HR roles see all records."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response is successful', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('candidate list response envelope', function () {",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data.candidates).to.be.an('array');",
                  "});",
                  "if (body.data && body.data.candidates && body.data.candidates.length) {",
                  "  pm.collectionVariables.set('candidate_id', body.data.candidates[0].id);",
                  "  pm.environment.set('candidate_id', body.data.candidates[0].id);",

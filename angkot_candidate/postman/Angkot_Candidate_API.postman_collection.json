              ]
            },
            "description": "Lists grouped checklist documents for the current user candidate. Optional query `candidate_id` is available for staff/reviewer roles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response is successful', function () { pm.response.to.have.status(200); });",

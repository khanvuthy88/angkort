{
  "info": {
    "_postman_id": "1b05086b-e119-4038-8f92-53bf5137a26b",
    "name": "Angkot Candidate API",
    "description": "Postman collection for `angkot_candidate` API routes under `/angkort/api/v1`.\n\nSuggested flow:\n1. Run `Auth / Login` to store bearer tokens.\n2. Run `Candidates / List Candidates` to store `candidate_id`.\n3. Run `Documents / List Current Candidate Documents` to store `document_id`.\n4. Use form, upload, review, content, and delete requests.\n\nRoutes are generated from `controllers/api.py`. The response envelope uses `status: \"success\"` or `status: \"error\"`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8012"
    },
    {
      "key": "api_prefix",
      "value": "/angkort/api/v1"
    },
    {
      "key": "username",
      "value": "candidate.portal@example.com"
    },
    {
      "key": "password",
      "value": "candidate_password"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_role",
      "value": ""
    },
    {
      "key": "candidate_id",
      "value": ""
    },
    {
      "key": "document_id",
      "value": ""
    },
    {
      "key": "photo_file_path",
      "value": ""
    },
    {
      "key": "document_file_path",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Authenticates a user and stores `access_token`, `refresh_token`, and `user_role`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response is successful', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('login returns tokens', function () {",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.data.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "const roleValues = ['candidate', 'candidate_general_staff', 'candidate_finance_staff', 'encharge_officer', 'recruiter', 'hr_document_reviewer', 'hr', 'user'];",
                  "pm.test('login returns a known role', function () { pm.expect(body.data.role).to.be.oneOf(roleValues); });",
                  "for (const key of ['access_token', 'refresh_token']) {",
                  "  if (body.data && body.data[key]) {",
                  "    pm.collectionVariables.set(key, body.data[key]);",
                  "    pm.environment.set(key, body.data[key]);",
                  "  }",
                  "}",
                  "if (body.data && body.data.role) {",
                  "  pm.collectionVariables.set('user_role', body.data.role);",
                  "  pm.environment.set('user_role', body.data.role);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "refresh"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Refreshes both JWT tokens using the current `refresh_token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response is successful', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('refresh returns tokens', function () { pm.expect(body.status).to.eql('success'); });",
                  "for (const key of ['access_token', 'refresh_token']) { if (body.data && body.data[key]) { pm.collectionVariables.set(key, body.data[key]); pm.environment.set(key, body.data[key]); } }"
                ]
              }
            }
          ]
        }
      ]
    },
    {

<odoo>
    <record id="view_hr_candidate_form_inherit_documents" model="ir.ui.view">
        <field name="name">hr.candidate.form.angkot.documents</field>
        <field name="model">hr.candidate</field>
        <field name="inherit_id" ref="hr_recruitment.hr_candidate_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_candidate_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-folder-open"
                    groups="angkot_candidate.group_candidate_encharge_officer,angkot_candidate.group_candidate_hr_reviewer">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
            </xpath>
            <xpath expr="//group/group[field[@name='user_id']]" position="inside">
                <field name="officer_user_id" groups="angkot_candidate.group_candidate_encharge_officer,angkot_candidate.group_candidate_hr_reviewer"/>
                <field name="portal_user_id" groups="angkot_candidate.group_candidate_hr_reviewer"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Employee Form" groups="angkot_candidate.group_candidate_encharge_officer,angkot_candidate.group_candidate_hr_reviewer">
                    <group>
                        <field name="candidate_stage" widget="statusbar" statusbar_visible="draft,submitted,accepted,rejected"/>
                    </group>
                    <group>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar"
                                   options="{'preview_image': 'image_1920'}"/>
                        </group>
                        <group>
                            <field name="khmer_name"/>
                            <field name="english_name"/>
                            <field name="position_name"/>
                            <field name="national_id_or_passport"/>
                        </group>
                    </group>
                    <group string="Personal Information" col="2">
                        <group>
                            <field name="partner_name" string="Candidate Name"/>
                            <field name="email_from"/>
                            <field name="partner_phone" string="Contact Number"/>
                            <field name="gender"/>
                            <field name="marital_status"/>
                            <field name="date_of_birth"/>
                        </group>
                        <group>
                            <field name="place_of_birth"/>
                            <field name="permanent_address"/>
                            <field name="current_address"/>
                        </group>
                    </group>
                    <group string="Family / Parent Information" col="2">
                        <group>
                            <field name="father_name"/>
                            <field name="father_job"/>
                            <field name="mother_name"/>
                            <field name="mother_job"/>
                        </group>
                        <group>
                            <field name="number_of_siblings"/>
                            <field name="family_contact_number"/>
                            <field name="family_permanent_address"/>
                            <field name="family_current_address"/>
                        </group>
                    </group>
                    <group string="Spouse Information" col="2">
                        <group>
                            <field name="spouse_name"/>
                            <field name="spouse_job"/>
                            <field name="number_of_children"/>
                        </group>
                        <group>
                            <field name="spouse_contact_number"/>
                            <field name="spouse_permanent_address"/>
                            <field name="spouse_current_address"/>
                        </group>
                    </group>
                    <group string="Education Information" col="2">
                        <group>
                            <field name="years_of_study"/>
                            <field name="degree_types"/>
                            <field name="education_major"/>
                        </group>
                        <group>
                            <field name="education_notes"/>
                        </group>
                    </group>
                    <group string="Short-Course Information" col="2">
                        <group>
                            <field name="short_course_certificates"/>
                            <field name="short_course_duration"/>
                            <field name="short_course_major"/>
                        </group>
                        <group>
                            <field name="short_course_notes"/>
                        </group>
                    </group>
                    <group string="Employment History" col="2">
                        <group>
                            <field name="latest_institution_name"/>
                            <field name="employment_history_position"/>
                            <field name="duration_of_work"/>
                        </group>
                        <group>
                            <field name="job_responsibility"/>
                            <field name="employment_history_notes"/>
                        </group>
                    </group>
                    <group string="Other Information" col="2">
                        <group>
                            <field name="had_injury"/>
                            <field name="had_injury_description" invisible="not had_injury"/>
                        </group>
                        <group>
                            <field name="arrested"/>
                            <field name="arrested_description" invisible="not arrested"/>
                        </group>
                    </group>
                    <group string="Declaration" col="2">
                        <group>
                            <field name="declaration_date"/>
                        </group>
                        <group>
                            <field name="declaration_signature" widget="text" placeholder="SVG signature or declaration payload"/>
                        </group>
                    </group>
                    <group string="Form Review">
                        <field name="candidate_form_review_note"/>
                        <field name="candidate_form_reviewed_by" readonly="1"/>
                        <field name="candidate_form_reviewed_on" readonly="1"/>
                    </group>
                </page>
                <page string="Document Checklist" groups="angkot_candidate.group_candidate_encharge_officer,angkot_candidate.group_candidate_hr_reviewer">
                    <group col="4">
                        <field name="required_document_count" readonly="1"/>
                        <field name="submitted_document_count" readonly="1"/>
                        <field name="accepted_document_count" readonly="1"/>
                    </group>
                    <field name="document_ids" context="{'default_candidate_id': id}">
                        <list create="0" delete="0">
                            <field name="document_type_id"/>
                            <field name="category"/>
                            <field name="status" widget="badge"
                                   decoration-danger="status == 'missing' or status == 'rejected'"
                                   decoration-info="status == 'submitted'"
                                   decoration-success="status == 'accepted'"/>
                            <field name="filename"/>
                            <field name="upload_date"/>
                            <field name="reviewed_by" optional="show"/>
                            <field name="reviewed_on" optional="show"/>
                            <button name="action_open_attachment" type="object" string="View" icon="fa-eye" invisible="not attachment_id"/>
                        </list>
                        <form string="Candidate Document">
                            <header>
                                <field name="status" widget="statusbar" statusbar_visible="missing,submitted,accepted,rejected"/>
                                <button name="action_accept" type="object" string="Accept" class="btn-primary"
                                        groups="angkot_candidate.group_candidate_hr_reviewer"
                                        invisible="status == 'accepted' or not attachment_id"/>
                                <button name="action_reject" type="object" string="Reject"
                                        groups="angkot_candidate.group_candidate_hr_reviewer"
                                        invisible="status == 'rejected' or not attachment_id"/>
                                <button name="action_reset_to_missing" type="object" string="Reset"
                                        groups="angkot_candidate.group_candidate_hr_reviewer"
                                        invisible="status == 'missing' and not attachment_id"/>
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="candidate_id" readonly="1"/>
                                        <field name="document_type_id" readonly="1"/>
                                        <field name="category" readonly="1"/>
                                        <field name="required" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="filename" readonly="1"/>
                                        <field name="upload_date" readonly="1"/>
                                        <field name="reviewed_by" readonly="1"/>
                                        <field name="reviewed_on" readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="review_note" placeholder="Add HR feedback or rejection reason here..."/>
                                </group>
                                <group>
                                    <field name="attachment_id" readonly="1"/>
                                </group>
                                <footer>
                                    <button name="action_open_attachment" type="object" string="Open File" class="btn-secondary" invisible="not attachment_id"/>
                                </footer>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

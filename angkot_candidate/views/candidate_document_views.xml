<odoo>
    <record id="view_angkot_candidate_document_tree" model="ir.ui.view">
        <field name="name">angkot.candidate.document.list</field>
        <field name="model">angkot.candidate.document</field>
        <field name="arch" type="xml">
            <list string="Candidate Documents" create="0" sample="1">
                <field name="candidate_id"/>
                <field name="document_type_id"/>
                <field name="category"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'missing' or status == 'rejected'"
                       decoration-info="status == 'submitted'"
                       decoration-success="status == 'accepted'"/>
                <field name="filename"/>
                <field name="upload_date"/>
                <field name="officer_user_id" optional="show"/>
                <field name="reviewed_by" optional="show"/>
                <button name="action_open_attachment" type="object" string="View" icon="fa-eye" invisible="not attachment_id"/>
            </list>
        </field>
    </record>

    <record id="view_angkot_candidate_document_form" model="ir.ui.view">
        <field name="name">angkot.candidate.document.form</field>
        <field name="model">angkot.candidate.document</field>
        <field name="arch" type="xml">
            <form string="Candidate Document">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="missing,submitted,accepted,rejected"/>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary"
                            groups="angkot_candidate.group_candidate_hr_reviewer"
                            invisible="status == 'accepted' or not attachment_id"/>
                    <button name="action_reject" type="object" string="Reject"
                            groups="angkot_candidate.group_candidate_hr_reviewer"
                            invisible="status == 'rejected' or not attachment_id"/>
                    <button name="action_reset_to_missing" type="object" string="Reset"
                            groups="angkot_candidate.group_candidate_hr_reviewer"
                            invisible="status == 'missing' and not attachment_id"/>
                    <button name="action_open_attachment" type="object" string="Open File" class="btn-secondary" invisible="not attachment_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="candidate_id" readonly="1"/>
                            <field name="document_type_id" readonly="1"/>
                            <field name="category" readonly="1"/>
                            <field name="required" readonly="1"/>
                        </group>
                        <group>
                            <field name="filename" readonly="1"/>
                            <field name="upload_date" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="reviewed_on" readonly="1"/>
                        </group>
                    </group>
                    <field name="review_note" placeholder="Add a review note for HR or the candidate..."/>
                    <field name="attachment_id" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_angkot_candidate_document_search" model="ir.ui.view">
        <field name="name">angkot.candidate.document.search</field>
        <field name="model">angkot.candidate.document</field>
        <field name="arch" type="xml">
            <search string="Candidate Documents">
                <field name="candidate_id"/>
                <field name="document_type_id"/>
                <field name="status"/>
                <filter string="Submitted" name="submitted" domain="[('status', '=', 'submitted')]"/>
                <filter string="Accepted" name="accepted" domain="[('status', '=', 'accepted')]"/>
                <filter string="Rejected" name="rejected" domain="[('status', '=', 'rejected')]"/>
                <filter string="Missing" name="missing" domain="[('status', '=', 'missing')]"/>
                <group expand="0" string="Group By">
                    <filter string="Candidate" name="group_by_candidate" context="{'group_by': 'candidate_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_angkot_candidate_document_type_tree" model="ir.ui.view">
        <field name="name">angkot.candidate.document.type.list</field>
        <field name="model">angkot.candidate.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" multi_edit="1">
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_angkot_candidate_document_type_form" model="ir.ui.view">
        <field name="name">angkot.candidate.document.type.form</field>
        <field name="model">angkot.candidate.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="required"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_angkot_candidate_document" model="ir.actions.act_window">
        <field name="name">Candidate Documents</field>
        <field name="res_model">angkot.candidate.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_angkot_candidate_document_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_angkot_candidate_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">angkot.candidate.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_angkot_candidate_documents"
        name="Candidate Documents"
        parent="hr_recruitment.menu_hr_recruitment_root"
        action="action_angkot_candidate_document"
        sequence="35"
        groups="angkot_candidate.group_candidate_encharge_officer,angkot_candidate.group_candidate_hr_reviewer"/>

    <menuitem
        id="menu_angkot_candidate_document_types"
        name="Candidate Document Types"
        parent="hr_recruitment.menu_hr_recruitment_config_applications"
        action="action_angkot_candidate_document_type"
        sequence="40"
        groups="angkot_candidate.group_candidate_hr_reviewer"/>
</odoo>

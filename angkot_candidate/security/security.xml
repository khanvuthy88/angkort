<odoo noupdate="1">
    <record id="group_candidate_portal" model="res.groups">
        <field name="name">Candidate</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_candidate_encharge_officer" model="res.groups">
        <field name="name">Encharge Officer</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
    </record>

    <record id="group_candidate_hr_reviewer" model="res.groups">
        <field name="name">HR Document Reviewer</field>
        <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
    </record>

    <record id="hr_candidate_encharge_officer_rule" model="ir.rule">
        <field name="name">Assigned candidates for encharge officers</field>
        <field name="model_id" ref="hr_recruitment.model_hr_candidate"/>
        <field name="domain_force">[('officer_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_encharge_officer'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="angkot_candidate_document_candidate_rule" model="ir.rule">
        <field name="name">Candidate documents own portal access</field>
        <field name="model_id" ref="model_angkot_candidate_document"/>
        <field name="domain_force">[('portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_portal'))]"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="angkot_candidate_document_officer_rule" model="ir.rule">
        <field name="name">Candidate documents assigned officer access</field>
        <field name="model_id" ref="model_angkot_candidate_document"/>
        <field name="domain_force">[('officer_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_encharge_officer'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="angkot_candidate_document_hr_rule" model="ir.rule">
        <field name="name">Candidate documents HR access</field>
        <field name="model_id" ref="model_angkot_candidate_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_hr_reviewer'))]"/>
    </record>

    <record id="angkot_candidate_document_type_candidate_rule" model="ir.rule">
        <field name="name">Candidate document types candidate read</field>
        <field name="model_id" ref="model_angkot_candidate_document_type"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_portal'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="angkot_candidate_document_type_officer_rule" model="ir.rule">
        <field name="name">Candidate document types officer read</field>
        <field name="model_id" ref="model_angkot_candidate_document_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_encharge_officer'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="angkot_candidate_document_type_hr_rule" model="ir.rule">
        <field name="name">Candidate document types HR access</field>
        <field name="model_id" ref="model_angkot_candidate_document_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('angkot_candidate.group_candidate_hr_reviewer'))]"/>
    </record>
</odoo>

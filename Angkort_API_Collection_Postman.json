{
  "info": {
    "_postman_id": "angkort-shop-api-collection",
    "name": "Angkort Shop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for Angkort Shop API, generated from shop.py."
  },
  "item": [
    {
      "name": "Order",
      "item": [
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/angkort/api/v1/my/order",
              "host": ["{{baseUrl}}"],
              "path": ["angkort","api","v1","my","order"]
            },
            "description": "Retrieve paginated list of orders for the authenticated user."
          }
        },
        {
          "name": "Get My Order Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/angkort/api/v1/my/order/:order_id",
              "host": ["{{baseUrl}}"],
              "path": ["angkort","api","v1","my","order",":order_id"]
            },
            "description": "Retrieve detailed information for a specific order."
          }
        },
        {
          "name": "Cart Checkout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart\": [\n    {\"product_id\": 1, \"quantity\": 2}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/angkort/api/v1/cart/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["angkort","api","v1","cart","checkout"]
            },
            "description": "Validate cart items and check stock availability."
          }
        },
        {
          "name": "Create Order (Global)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": 1,\n  \"order_lines\": [\n    {\"product_id\": 1, \"quantity\": 2}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/angkort/api/v1/order",
              "host": ["{{baseUrl}}"],
              "path": ["angkort","api","v1","order"]
            },
            "description": "Create a new sale order (global order creation)."
          }
        }
      ]
    },
